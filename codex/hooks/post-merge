#!/usr/bin/env bash
# After a merge/pull: sync the agent-skills submodule to the recorded commit
# (skipping if it has local changes), then re-apply portable Codex config.
top="$(git rev-parse --show-toplevel)"
if [ -n "$(git -C "$top/agent-skills" status --porcelain 2>/dev/null)" ]; then
  echo "agent-skills submodule has local changes; skipping submodule sync" >&2
else
  git -C "$top" submodule update --init agent-skills
fi
exec "$top/codex/bin/codex-sync"
